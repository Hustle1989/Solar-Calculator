# Copy to .env.local. Neon-managed values come from `neon env pull` (or `neon deploy`).

# --- Neon (managed by `neon env pull`) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# --- App config (add these yourself) ---
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=
# Browser copy of the Realtime URL (Next.js expands $VAR)
NEXT_PUBLIC_NEON_REALTIME_URL=$NEON_REALTIME_URL
# Local only: shows the demo-account buttons on the sign-in page. Never set in production.
NEXT_PUBLIC_DEMO_ACCOUNTS=1
# Optional: password used by `npm run db:seed` for demo accounts
# SEED_DEMO_PASSWORD=
